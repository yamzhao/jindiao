# Credential-free demo runtime. Change to openai_compatible and fill the model
# fields below to run the official model-backed AgentTeams runtime.
MODEL_PROVIDER=offline_mock
MODEL_NAME=deterministic-mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TEMPERATURE=0
# deterministic_harness is for local fixtures/tests only. Switch to formal
# together with a complete non-fake model route for real Agent execution.
JINDIAO_AGENT_RUNTIME_MODE=deterministic_harness
# Explicit opt-in for the credentialed single-Agent smoke test.
JINDIAO_RUN_LIVE_SINGLE=0
# Explicit opt-in for the credentialed AgentTeams multi-Agent smoke test.
JINDIAO_RUN_LIVE_MULTI=0

# Tianyancha MCP. Keep the authorization value only in your local .env.
JINDIAO_DATA_SOURCE_MODE=mock
TIANYANCHA_MCP_URL=https://mcp.tianyancha.com/v1
TIANYANCHA_MCP_AUTHORIZATION=
JINDIAO_TIANYANCHA_ROUTES_PATH=config/tianyancha-capability-routes.json
JINDIAO_LIVE_FALLBACK_SCENARIO_ID=normal-enterprise
# Optional live-mode supplement. The provider only requests
# https://www.tianyancha.com/annualReport/{company_id}/{year}.
JINDIAO_TIANYANCHA_ANNUAL_REPORT_ENABLED=true
JINDIAO_TIANYANCHA_ANNUAL_REPORT_LOOKBACK_YEARS=5
JINDIAO_TIANYANCHA_ANNUAL_REPORT_TIMEOUT_SECONDS=15

# Runtime
JINDIAO_ENV=development
JINDIAO_LOG_LEVEL=INFO
JINDIAO_MOCK_DATA_ROOT=mock_data
JINDIAO_ARTIFACT_ROOT=artifacts
# Local single-process reporting feedback Demo; requires development/test + memory/local.
JINDIAO_REPORTING_DEMO_ENABLED=false
JINDIAO_MAX_CONCURRENCY=4
JINDIAO_REQUEST_TIMEOUT_SECONDS=300
JINDIAO_MAX_TOOL_CALLS=60
JINDIAO_MAX_REPAIR_ROUNDS=2
JINDIAO_MAX_LLM_REQUESTS=64
JINDIAO_MAX_INPUT_TOKENS=300000
JINDIAO_MAX_OUTPUT_TOKENS=100000
JINDIAO_MAX_TOTAL_TOKENS=400000
# false: observe token usage without enforcing numeric token ceilings (cost can exceed them).
JINDIAO_ENFORCE_TOKEN_BUDGET=true
JINDIAO_MAX_SCHEMA_RETRIES=4
JINDIAO_MAX_SNAPSHOT_READS=240
JINDIAO_ALLOW_DEGRADED_MOCK=false

# Run API lifecycle. Keep attached for competition and local demos.
JINDIAO_EXECUTION_PROFILE=attached
JINDIAO_STORAGE_BACKEND=memory
JINDIAO_DETACHED_PROBE_PASSED=false
JINDIAO_MAX_EVENT_QUEUE=256
JINDIAO_MAX_EVENTS_PER_RUN=10000
JINDIAO_EVENT_RETENTION_SECONDS=86400

# Skill evolution is review-gated by default.
JINDIAO_SKILL_EVOLUTION_ENABLED=true
JINDIAO_SKILL_EVOLUTION_AUTO_APPROVE=false
