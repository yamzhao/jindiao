# Short-term real AgentTeams integration profile, not a production cost recommendation.
# Apply only to an existing real-source runtime with its credentials already configured.
# Does not contain or change MODEL_API_KEY / TIANYANCHA_MCP_AUTHORIZATION.
# Defaults in application settings are intentionally unchanged.
JINDIAO_REQUEST_TIMEOUT_SECONDS=600
JINDIAO_MAX_LLM_REQUESTS=160
JINDIAO_MAX_TOOL_CALLS=160
JINDIAO_MAX_CONCURRENCY=6
JINDIAO_MAX_INPUT_TOKENS=2400000
JINDIAO_MAX_OUTPUT_TOKENS=300000
JINDIAO_MAX_TOTAL_TOKENS=2700000
JINDIAO_MAX_REPAIR_ROUNDS=2
JINDIAO_MAX_SCHEMA_RETRIES=12

# Never use this profile to enable mock fallback, detached execution or public HTTP.
# These limits apply to the investigation ledger. Acquisition usage is separately
# reported, and concurrent requests may finish after the ledger becomes exhausted.
# They are NOT a provider-account spending cap.
