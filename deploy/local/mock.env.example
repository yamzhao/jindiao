# Dedicated credential-free container profile for bin/local. No host dotenv is loaded.
MODEL_PROVIDER=offline_mock
MODEL_NAME=deterministic-mock
JINDIAO_ENV=development
JINDIAO_AGENT_RUNTIME_MODE=deterministic_harness
JINDIAO_DATA_SOURCE_MODE=mock
JINDIAO_EXECUTION_PROFILE=attached
JINDIAO_STORAGE_BACKEND=local
JINDIAO_DETACHED_PROBE_PASSED=false
JINDIAO_ALLOW_DEGRADED_MOCK=false
JINDIAO_REPORTING_DEMO_ENABLED=false
JINDIAO_ARTIFACT_ROOT=/app/artifacts
JINDIAO_MOCK_DATA_ROOT=/app/mock_data
