# Copy to project-root .env.bff.local, chmod 600, and edit locally.
# EMPTY secrets/users intentionally prevent startup. Do not paste secrets in chat.
JINDIAO_BFF_DEVELOPMENT=true
JINDIAO_BFF_PUBLIC_ORIGIN=http://127.0.0.1:18082
JINDIAO_BFF_GATEWAY_ORIGIN=https://gateway.example
JINDIAO_BFF_RUNTIME_NAME=jindiao-demo
JINDIAO_BFF_API_KEY=
JINDIAO_BFF_IDENTITY_KEY=
# JSON from: python -m jindiao.bff.password alice
JINDIAO_BFF_USERS={}
# Optional fixed gateway endpoint; omit entirely unless needed.
# JINDIAO_BFF_ENDPOINT=Latest
# Explicit opt-in for the native OS trust store; certificate checks stay enabled.
# macOS verification does not prove Linux/container certificate-chain completeness.
JINDIAO_BFF_TLS_TRUST_STORE=certifi
# Optional read-only PEM chain supplement; certifi mode only. Never use a leaf certificate.
# JINDIAO_BFF_TLS_CA_FILE=/app/certs/globalsign-rsa-ov-2018.pem
JINDIAO_BFF_SESSION_TTL=3600
JINDIAO_BFF_RUN_TTL=28800
JINDIAO_BFF_MAX_SESSIONS=256
JINDIAO_BFF_MAX_RUNS=1024
JINDIAO_BFF_CREATE_PER_MINUTE=3
JINDIAO_BFF_REQUESTS_PER_MINUTE=120
JINDIAO_BFF_MAX_CONNECTIONS=32
JINDIAO_BFF_CONNECTIONS_PER_USER=4
# Default 262144 bytes. Optional bounded probe for large report.completed frames.
# Real multi report data line 327418 bytes passed with this explicit cap on 2026-09-06.
# Reports larger than 1 MiB still fail closed; use the result GET fallback.
# JINDIAO_BFF_MAX_EVENT_BYTES=1048576
JINDIAO_BFF_UPSTREAM_TIMEOUT=120
JINDIAO_BFF_STREAM_TIMEOUT=1800
