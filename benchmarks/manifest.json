      "category": "report_gap",
      "enterprise": {"company_name": "金调远帆服务有限公司"},
      "source_status_overrides": {"judicial": "verified_empty"}
    },
    {
      "case_id": "judicial-restriction",
      "scenario_id": "judicial-restriction",
      "scenario_version": "v1.0.0",
      "category": "judicial_risk",
      "enterprise": {"company_name": "金调云岑建设有限公司"}
    },
    {
      "case_id": "operations-source-error",
      "scenario_id": "operating-pressure",
      "scenario_version": "v1.0.0",
      "category": "source_error",
      "enterprise": {"company_name": "金调沧澜供应链有限公司"},
      "source_status_overrides": {"operations": "source_error"}
    },
    {
      "case_id": "ambiguous-name-north",
      "scenario_id": "ambiguous-north",
      "scenario_version": "v1.0.0",
      "category": "entity_ambiguous",
      "enterprise": {"company_name": "金调同名实业"},
